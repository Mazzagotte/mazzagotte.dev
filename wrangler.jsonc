{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mazzagotte-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // The hub lives at the bare domain. The split-flap display moved to splitflap.mazzagotte.dev,
  // and SpareTime stays at sparetime.mazzagotte.dev.
  "routes": [{ "pattern": "mazzagotte.dev", "custom_domain": true }],
  "workers_dev": false,
  // Keep the variables you set in the dashboard (Access settings) when GitHub deploys run.
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs through the Worker first, so the login check covers the app's files too.
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "mazzagotte-backups" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mazzagotte-hub",
      "database_id": "7c2c7c6c-2a4c-4954-999e-22e52dda5964",
      "migrations_dir": "migrations"
    },
    // Read-only use: the hub backs these up nightly. Each site still owns its own database.
    { "binding": "SPARETIME_DB", "database_name": "sparetime", "database_id": "6eb77ed3-bf35-4fcd-83c7-379940f88eac" },
    { "binding": "USBC_DB", "database_name": "ada-county-usbc-portal", "database_id": "6f7d4e42-9220-43a1-9f28-c1fb594a9396" }
  ],
  // Uptime checks every minute (the shortest schedule Cloudflare allows).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "TIMEZONE": "America/Denver",
    "VAPID_SUBJECT": "https://mazzagotte.dev",
    // Cloudflare Access (Zero Trust team + the mazzagotte.dev application). Not secret.
    "ACCESS_TEAM_DOMAIN": "https://divine-union-90c8.cloudflareaccess.com",
    "ACCESS_AUD": "40dd0ac38862f4709e022b5478aaed54af84589c741eb6cd9f892a1b7d32b131"
    // Set in the dashboard (Settings → Variables and Secrets), not here:
    //   OWNER_EMAIL  your email (extra lock; kept out of the repo)
    // Secrets (encrypted): RAILWAY_HOOK_SECRET, DEPLOY_HOOK_SECRET, MONEY_HOOK_SECRET
  }
}
